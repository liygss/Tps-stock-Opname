# Salin file ini menjadi .env lalu isi nilainya.
# Ambil dari Supabase Dashboard > Project Settings > API.
# Pakai publishable key (sb_publishable_...) atau anon key (eyJ...).
# JANGAN pakai secret key (sb_secret_...).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=PASTE_PUBLISHABLE_OR_ANON_KEY
BUCKET=foto
